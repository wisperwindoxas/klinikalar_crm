# ==============================================================================
# Klinika Navbat Monorepo .gitignore
# Covers: Backend (Node/TS), User-Panel (Vite/React), Super-Admin-Panel, 
#         TV-Display, mobile_app (Flutter/Android/iOS), Docker & macOS/Windows
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Local Environment
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 2. IDE & Editor Specific
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.history/

# VS Code (ignore workspace state, keep configuration if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 3. Environment Variables & Credentials (Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
eskizvps.env
*.env
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. Node.js & Web Projects (Backend, User-Panel, Super-Admin-Panel, TV-Display)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/

# Build artifacts
dist/
**/dist/
build/
**/build/
!Desktop-App/build/
!Offline-Edition/Desktop-App/build/
release/
**/release/
clinic_offline_pgdata/
**/clinic_offline_pgdata/
.next/
out/
.turbo/
.cache/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic & coverage
coverage/
**/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 5. Flutter & Dart (mobile_app)
# ------------------------------------------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/
**/doc/api/
**/.widget_preview/

# Android build artifacts & configs
**/android/.gradle/
**/android/.kotlin/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/

# iOS / macOS build artifacts
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/DerivedData/

# Flutter Symbols & Maps
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 6. Binary & Package Builds (APKs, AABs, Bundles, Electron Releases)
# ------------------------------------------------------------------------------
# Large binaries should not bloat Git history (use GitHub Releases)
*.apk
*.aab
*.ipa
*.app
*.dmg
*.exe
*.zip
*.blockmap
*.dSYM/
Desktop-App/release/
Desktop-App/dist/
Backend/cache/audio/

# ------------------------------------------------------------------------------
# 7. Temporary / Scratch Files
# ------------------------------------------------------------------------------
scratch/
**/scratch/
tmp/
temp/
*.tmp
Offline-Edition/data/
