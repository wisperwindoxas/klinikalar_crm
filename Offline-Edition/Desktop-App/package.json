{
  "name": "klinika-offline",
  "version": "1.0.0",
  "description": "Klinika Standalone Offline Edition — Elektron Navbat va Boshqaruv Tizimi",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.klinika.offline",
    "productName": "Klinika-Offline",
    "publish": [
      {
        "provider": "github",
        "owner": "wisperwindoxas",
        "repo": "klinikalar_crm"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../Backend/dist",
        "to": "backend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../Backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Klinika-admin",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
